# Vercel Deployment Environment Variables
# Copy these to Vercel Dashboard > Settings > Environment Variables

# Database (Vercel Postgres auto-provides these)
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# DATABASE_URL=

# Or use external Postgres (Neon/Supabase)
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Application
NODE_ENV=production
PORT=5000

# Security (REQUIRED - Generate secure random strings)
ADMIN_JWT_SECRET=change-this-to-secure-random-string-min-32-chars
ADMIN_REFRESH_SECRET=change-this-to-different-secure-random-string
PASSWORD_SALT=change-this-to-secure-salt-string

# SMS Providers (Optional)
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SAFARICOM_CONSUMER_KEY=
SAFARICOM_CONSUMER_SECRET=
SAFARICOM_SHORTCODE=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI Chatbot (Optional)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# External APIs (Optional)
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
