{
  "version": 2,
  "installCommand": "npm install --prefix backend",
  "buildCommand": "npm install --prefix backend",
  "devCommand": "npm run dev --prefix backend",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
